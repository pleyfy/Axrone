{
    "name": "axrone",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "packageManager": "yarn@1.22.22",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "bootstrap": "lerna bootstrap --use-workspaces",
        "build": "lerna run build --stream --concurrency=6",
        "build:clean": "node ./scripts/clean-build-cache.mjs && lerna run build --stream --concurrency=6 --skip-nx-cache",
        "build:export-templates": "node ./scripts/build-export-templates.mjs",
        "clean": "lerna run clean && lerna clean --yes && rimraf node_modules",
        "examples:dev": "vite --config vite.examples.config.ts",
        "examples:build": "vite build --config vite.examples.config.ts",
        "examples:preview": "vite preview --config vite.examples.config.ts",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "lint": "lerna run lint --parallel --stream",
        "lint:fix": "lerna run lint:fix --parallel --stream",
        "test": "vitest",
        "test:ci": "vitest run --exclude '**/script-performance-*.test.ts' --exclude '**/webgl-resource-leak-detection.test.ts' --exclude '**/perf-test-utils.test.ts'",
        "test:physics-3d-wasm": "yarn vitest run packages/physics-3d-wasm && yarn workspace @axrone/physics-3d-wasm run test:memory",
        "test:architecture": "vitest run --config vitest.config.architecture.ts",
        "test:profiles": "vitest run --config vitest.config.architecture.ts tests/architecture/scene-split/runtime-profile-entry.test.ts tests/architecture/scene-split/runtime-profile-smoke.test.ts tests/architecture/scene-split/runtime-profile-capability-graph.test.ts tests/architecture/scene-split/playable-2d-entry-boundary.test.ts",
        "test:render-governance": "vitest run --config vitest.config.architecture.ts tests/architecture/render-split",
        "test:input-governance": "vitest run --config vitest.config.architecture.ts tests/architecture/input-split",
        "test:consumer-migration": "vitest run --config vitest.config.architecture.ts tests/architecture/scene-split/core-consumer-migration-boundary.test.ts",
        "test:duplicate-governance": "node ./scripts/duplicate-governance.mjs",
        "test:utility-governance": "node ./scripts/utility-governance.mjs",
        "test:hardening": "yarn test:profiles && yarn test:render-governance && yarn test:input-governance && yarn test:consumer-migration && yarn test:duplicate-governance && yarn test:utility-governance",
        "test:runtime-profile-governance": "node ./scripts/runtime-profile-governance.mjs",
        "test:playable-2d-bundle-governance": "node ./scripts/playable-2d-governance.mjs --mode=bundle",
        "test:playable-2d-size-governance": "node ./scripts/playable-2d-governance.mjs --mode=size",
        "test:playable-2d-smoke": "node ./scripts/playable-2d-governance.mjs --mode=smoke",
        "test:engine-benchmark-governance": "node ./scripts/engine-benchmark-governance.mjs",
        "test:capability-descriptor-governance": "node ./scripts/capability-descriptor-governance.mjs",
        "generate:knowledge": "node ./scripts/generate-engine-knowledge.mjs",
        "test:knowledge-governance": "node ./scripts/generate-engine-knowledge.mjs --check",
        "test:watch": "vitest --watch",
        "test:ui": "vitest --ui",
        "test:browser": "vitest run --config vitest.config.browser.ts",
        "test:webgl": "playwright test --config playwright.config.ts",
        "bench:engine": "node ./scripts/engine-benchmark-runner.mjs",
        "bench:engine:quick": "node ./scripts/engine-benchmark-runner.mjs --iterations=3 --warmup=1 --durationSec=5 --objectCounts=2600 --comparisonModes=no-culling",
        "bench:engine:startup": "node ./scripts/engine-benchmark-runner.mjs --iterations=3 --warmup=1 --durationSec=5 --objectCounts=19600 --comparisonModes=no-culling --isolateRuns",
        "test:coverage": "vitest --coverage",
        "typecheck": "tsc --noEmit --strict",
        "typecheck:scene-runtime": "cd packages/scene-runtime && tsc --noEmit --strict",
        "test:all": "yarn test && yarn test:architecture && yarn test:browser && yarn test:webgl",
        "ci:engine-hardening": "yarn test:ci && yarn test:architecture && yarn verify:engine-hardening",
        "ci:physics-allocation": "node --expose-gc ./scripts/physics-allocation-governance.mjs",
        "verify:engine-hardening": "yarn test:hardening && yarn build && yarn test:runtime-profile-governance && yarn test:capability-descriptor-governance && yarn test:playable-2d-bundle-governance && yarn test:playable-2d-size-governance && yarn test:playable-2d-smoke && yarn test:engine-benchmark-governance -- --refresh --headless --strictStability && yarn examples:build",
        "docs": "typedoc",
        "prepare": "husky"
    },
    "lint-staged": {
        "**/*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "**/*.{js,jsx,json,md}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.0",
        "@commitlint/config-conventional": "^19.8.0",
        "@playwright/test": "^1.48.0",
        "@rollup/plugin-commonjs": "^28.0.3",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-terser": "^0.4.4",
        "@tailwindcss/postcss": "^4.2.2",
        "@types/node": "^22.14.1",
        "@typescript-eslint/eslint-plugin": "^8.30.1",
        "@typescript-eslint/parser": "^8.30.1",
        "@vitest/browser": "^2.1.8",
        "@vitest/coverage-v8": "^2.1.8",
        "@vitest/ui": "^2.1.8",
        "autoprefixer": "^10.4.27",
        "esbuild": "^0.28.1",
        "eslint": "^9.24.0",
        "eslint-config-prettier": "^10.1.2",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-vitest": "^0.5.4",
        "happy-dom": "^15.11.7",
        "husky": "^9.1.7",
        "jscpd": "^4.0.9",
        "lerna": "^8.2.2",
        "lint-staged": "^15.5.1",
        "monaco-editor": "^0.55.1",
        "playwright": "^1.48.0",
        "postcss": "^8.5.8",
        "prettier": "^3.5.3",
        "punycode2": "^1.0.1",
        "rimraf": "^6.0.1",
        "rollup": "^4.40.0",
        "rollup-plugin-dts": "^6.2.1",
        "rollup-plugin-esbuild": "^6.2.1",
        "rollup-plugin-peer-deps-external": "^2.2.4",
        "tailwindcss": "^4.2.2",
        "tsx": "^4.20.3",
        "typedoc": "^0.28.2",
        "typedoc-plugin-markdown": "^4.6.2",
        "typescript": "^5.8.3",
        "vite": "^6.0.7",
        "vitest": "^2.1.8"
    },
    "dependencies": {
        "@types/three": "^0.183.1",
        "three": "^0.183.2"
    }
}
