<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup Label="CentralizedPackageVersions">
    <BenchmarkDotNetVersion>0.14.0</BenchmarkDotNetVersion>
    <MicrosoftDotNetIlCompilerVersion>10.0.14</MicrosoftDotNetIlCompilerVersion>
    <FluentAssertionsVersion>8.3.0</FluentAssertionsVersion>
    <AwesomeAssertionsVersion>9.6.0</AwesomeAssertionsVersion>
    <XunitVersion>2.9.3</XunitVersion>
    <XunitRunnerVersion>2.8.2</XunitRunnerVersion>
    <CoverletVersion>6.0.4</CoverletVersion>
    <SilkNetVersion>2.23.0</SilkNetVersion>
    <MoqVersion>4.20.72</MoqVersion>
    <AlimerMeshOptimizerVersion>1.2.1</AlimerMeshOptimizerVersion>
    <BasisUniversalVersion>1.0.0</BasisUniversalVersion>
  </PropertyGroup>

  <ItemGroup Label="TestDependencies">
    <PackageVersion Include="xunit" Version="$(XunitVersion)" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="$(XunitRunnerVersion)" />
    <PackageVersion Include="FluentAssertions" Version="$(FluentAssertionsVersion)" />
    <PackageVersion Include="AwesomeAssertions" Version="$(AwesomeAssertionsVersion)" />
    <PackageVersion Include="coverlet.collector" Version="$(CoverletVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
  </ItemGroup>

  <ItemGroup Label="PerformanceDependencies">
    <PackageVersion Include="BenchmarkDotNet" Version="$(BenchmarkDotNetVersion)" />
  </ItemGroup>

  <ItemGroup Label="NativeAotToolchain">
    <PackageVersion Include="Microsoft.DotNet.ILCompiler" Version="$(MicrosoftDotNetIlCompilerVersion)" />
  </ItemGroup>

  <ItemGroup Label="AssetCodecDependencies">
    <PackageVersion Include="Alimer.Bindings.MeshOptimizer" Version="$(AlimerMeshOptimizerVersion)" />
    <PackageVersion Include="BasisUniversal.NET" Version="$(BasisUniversalVersion)" />
    <PackageVersion Include="BasisUniversal.Native" Version="$(BasisUniversalVersion)" />
  </ItemGroup>

  <ItemGroup Label="RenderDependencies">
    <PackageVersion Include="Silk.NET.OpenGL" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Silk.NET.Core" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Silk.NET.Input" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Silk.NET.Input.Common" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Silk.NET.OpenAL" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageVersion Include="Moq" Version="$(MoqVersion)" />
  </ItemGroup>

</Project>