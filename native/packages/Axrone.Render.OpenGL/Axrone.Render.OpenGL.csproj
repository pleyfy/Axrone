<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axrone.Render.OpenGL</RootNamespace>
    <AssemblyName>Axrone.Render.OpenGL</AssemblyName>
    <Description>OpenGL backend for the Axrone renderer: context, resources, mesh, shading, pipeline and frame graph.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AotCompatibility">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA1720: Int/Float/Short member names — GL type-name parity, intentional -->
    <NoWarn>$(NoWarn);CA1720</NoWarn>
    <!-- CA1028: byte-backed GPU enums — compact descriptors matching GL field widths, intentional -->
    <NoWarn>$(NoWarn);CA1028</NoWarn>
    <!-- CA1711: TextureFormatFlags — framework-blessed bitmask naming (cf. BindingFlags) -->
    <NoWarn>$(NoWarn);CA1711</NoWarn>
    <!-- CA1031: bulk-dispose must attempt every resource; failures aggregate, never vanish -->
    <NoWarn>$(NoWarn);CA1031</NoWarn>
    <!-- CA1724: FrameGraph type in FrameGraph namespace — established render-graph naming -->
    <NoWarn>$(NoWarn);CA1724</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="PublicApi">
    <InternalsVisibleTo Include="Axrone.Render.OpenGL.Tests" />
    <InternalsVisibleTo Include="Axrone.Render.Effects.Tests" />
  </ItemGroup>

  <ItemGroup Label="Dependencies">
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="Silk.NET.Core" />
    <ProjectReference Include="../Axrone.Render.Core/Axrone.Render.Core.csproj" />
    <ProjectReference Include="../Axrone.Lighting/Axrone.Lighting.csproj" />
    <ProjectReference Include="../Axrone.Numeric/Axrone.Numeric.csproj" />
    <ProjectReference Include="../Axrone.Utility/Axrone.Utility.csproj" />
    <ProjectReference Include="../Axrone.Geometry/Axrone.Geometry.csproj" />
    <ProjectReference Include="../Axrone.Execution/Axrone.Execution.csproj" />
    <ProjectReference Include="../Axrone.Hash/Axrone.Hash.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="benchmarks/**" />
  </ItemGroup>

</Project>
