<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axrone.Ui.Controls</RootNamespace>
    <AssemblyName>Axrone.Ui.Controls</AssemblyName>
    <Description>Retained UI control catalog for the Axrone engine: widget lifecycle, control state and input behavior on top of the UI foundation.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AotCompatibility">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <NoWarn>$(NoWarn);CA1000</NoWarn>
    <NoWarn>$(NoWarn);CA1815</NoWarn>
    <NoWarn>$(NoWarn);CA1711</NoWarn>
    <NoWarn>$(NoWarn);CA1028</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="PublicApi">
    <InternalsVisibleTo Include="Axrone.Ui.Controls.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Ui/Axrone.Ui.csproj" />
    <ProjectReference Include="../Axrone.Ui.Input/Axrone.Ui.Input.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

</Project>
