<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Axrone.Event.Benchmarks</RootNamespace>
    <AssemblyName>Axrone.Event.Benchmarks</AssemblyName>
    <Description>Microbenchmarks for Axrone.Event task-queue submit, run and drain paths.</Description>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet emits IL that reflects over these types; trimming would break the harness. -->
    <IsTrimmable>false</IsTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA1052: static holder types — benchmark fixtures are conventionally plain static classes -->
    <NoWarn>$(NoWarn);CA1052</NoWarn>
    <!-- CA1515: make types internal — BenchmarkSwitcher discovers fixtures through public types -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
    <!-- CA1861: inline arrays in benchmark payloads — literals keep the fixtures readable -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Event.csproj" />
  </ItemGroup>

</Project>
