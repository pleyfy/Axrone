<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <!-- CA1849: this console smoke is intentionally synchronous after startup. -->
    <NoWarn>$(NoWarn);CA1515;CA1849</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Axrone.AssetGltf.Codecs.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.ILCompiler" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\TestData\draco-grid-1k.drc" Link="TestData\draco-grid-1k.drc" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
