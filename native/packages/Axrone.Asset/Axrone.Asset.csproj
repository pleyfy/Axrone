<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axrone.Asset</RootNamespace>
    <AssemblyName>Axrone.Asset</AssemblyName>
    <Description>Asset database with import pipeline, references and snapshots for the Axrone engine.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AotCompatibility">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="SuppressedRules">
    <!-- CA2225: Implicit operators need named alternatives — nominal
         comparison surface is complete without them. -->
    <NoWarn>$(NoWarn);CA2225</NoWarn>
    <!-- CA1034: Nested types — duck-typed struct enumerators are an
         intentional zero-allocation traversal design. -->
    <NoWarn>$(NoWarn);CA1034</NoWarn>
    <!-- CA1051: Visible instance fields — explicit-layout payloads are
         intentional wire layouts. -->
    <NoWarn>$(NoWarn);CA1051</NoWarn>
    <!-- CA1032: Standard exception ctors — asset errors carry coded
         (code, message) payloads instead of free-form messages. -->
    <NoWarn>$(NoWarn);CA1032</NoWarn>
    <!-- CA1028: byte-backed asset enums — wire-sized discriminants,
         intentional. -->
    <NoWarn>$(NoWarn);CA1028</NoWarn>
    <!-- CA1815: Equals on stateless structs — policy structs carry
         no state to compare. -->
    <NoWarn>$(NoWarn);CA1815</NoWarn>
    <!-- CA1000: Static members on generic types — policy monomorphization
         exposes static abstracts on generic structs by design. -->
    <NoWarn>$(NoWarn);CA1000</NoWarn>
    <!-- CA1031: Catching general exceptions — intentional for per-importer
         routing and subscriber fan-out. Every refusal carries a code
         (AssetError.Code, AssetCodecFailure.CodeOf) or is isolated and
         surfaced; the default data codec distinguishes foreign payloads
         (asset.codec.tag.unknown, asset.codec.payload.empty) from broken
         ones (asset.codec.json.invalid) on both the tagged-object path and
         the typed-JSON path. -->
    <NoWarn>$(NoWarn);CA1031</NoWarn>
    <!-- CA1710: Exception names mirror the web asset contract (AssetError,
         AssetConfigurationError); renaming would break the contract. -->
    <NoWarn>$(NoWarn);CA1710</NoWarn>
    <!-- CA1720: FromObject mirrors the JSON domain term (JsonObject);
         renaming would corrupt the JSON vocabulary. -->
    <NoWarn>$(NoWarn);CA1720</NoWarn>
    <!-- CA1040: Empty marker interfaces drive the typestate builder phases. -->
    <NoWarn>$(NoWarn);CA1040</NoWarn>
    <!-- CA1054: String-to-URI conversion is the branded nominal's job. -->
    <NoWarn>$(NoWarn);CA1054</NoWarn>
    <!-- CA1308: Lowercase tokens are the wire format; Invariant culture
         keeps the mapping deterministic. -->
    <NoWarn>$(NoWarn);CA1308</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="PublicApi">
    <InternalsVisibleTo Include="Axrone.Asset.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Axrone.Event/Axrone.Event.csproj" />
    <ProjectReference Include="../Axrone.Hash/Axrone.Hash.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="benchmarks/**" />
  </ItemGroup>

</Project>
